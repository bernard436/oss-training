[
 {
  "name": "submit_event",
  "description": "Submit one structured planning event read from a message of the Lyon plant. Use only ids that exist. Leave out what is not in the message.",
  "input_schema": {
   "type": "object",
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "quantity_change",
      "date_change",
      "rush_order",
      "cancellation",
      "material_late",
      "quality_hold",
      "machine_down",
      "none"
     ]
    },
    "at": {
     "type": "string",
     "description": "When the message was sent, YYYY-MM-DD HH:MM"
    },
    "order_id": {
     "type": "string"
    },
    "customer": {
     "type": "string"
    },
    "product_code": {
     "type": "string"
    },
    "tonnes": {
     "type": "number"
    },
    "due": {
     "type": "string"
    },
    "available_from": {
     "type": "string"
    },
    "line": {
     "type": "string"
    },
    "from": {
     "type": "string"
    },
    "to": {
     "type": "string"
    },
    "confidence": {
     "type": "number",
     "description": "0 to 1"
    },
    "evidence": {
     "type": "string",
     "description": "The words of the message that support the event"
    }
   },
   "required": [
    "type",
    "confidence",
    "evidence"
   ]
  }
 },
 {
  "name": "write_explanation",
  "description": "Write the explanation of a plan change for a shift leader: five lines at most, order ids and rule ids cited.",
  "input_schema": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string"
    }
   },
   "required": [
    "text"
   ]
  }
 }
]